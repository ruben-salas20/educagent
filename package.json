{
  "name": "@educagent/cli",
  "version": "0.0.0-pre",
  "description": "CLI tutor inteligente con base psicopedagógica",
  "type": "module",
  "private": true,
  "engines": { "node": ">=20.0.0" },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.12.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "license": "Apache-2.0",
  "repository": "github:ruben-salas20/educagent",
  "homepage": "https://github.com/ruben-salas20/educagent",
  "bugs": "https://github.com/ruben-salas20/educagent/issues",
  "author": "Ruben Salas <rubend.salasp@uqvirtual.edu.co>",
  "keywords": ["cli", "tutor", "education", "byok", "spaced-repetition", "typescript"]
}
